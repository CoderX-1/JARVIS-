# Choose: openai, gemini, or compatible
AI_PROVIDER=openai
AI_FALLBACK_PROVIDER=gemini

# Provider-specific defaults
OPENAI_MODEL=gpt-5-mini
GEMINI_MODEL=gemini-3.8-flash

# Secrets: prefer the encrypted START JARVIS / REPLACE JARVIS KEYS launchers.
# If you deliberately use a private local .env instead, uncomment only the
# provider you need. Never commit the resulting .env file.
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# BRAVE_SEARCH_API_KEY=  # Optional: independent topic-to-URL discovery for professional reports
# GEMINI_REPORT_MODEL=gemini-3.5-flash-lite  # Optional override; report-only default
# GEMINI_REPORT_FALLBACK_MODEL=gemini-2.5-flash  # One bounded fallback on HTTP 503
# GEMINI_PRESENTATION_MODEL=gemini-3.7-flash  # PPTX synthesis favors quality; voice is unchanged
# GEMINI_PRESENTATION_FALLBACK_MODEL=gemini-3.5-flash  # One bounded fallback on HTTP 503
# OPENAI_PRESENTATION_MODEL=gpt-5-mini  # Used once if the Gemini PPT model returns HTTP 404/503
# ELEVENLABS_API_KEY=

# Optional single-account desktop launch gate. Configure one confirmed user
# in Supabase Auth, turn public signups OFF in the Supabase dashboard, then
# add your project URL and publishable/anon key locally. Do not use a service
# role/secret key in a desktop application. Enable only after live testing.
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=sb_publishable_...
# JARVIS_AUTH_REQUIRED=1

# Only for another OpenAI-compatible endpoint:
# AI_PROVIDER=compatible
# AI_BASE_URL=https://your-provider.example/v1
# AI_MODEL=your-model-name
# AI_API_KEY=
